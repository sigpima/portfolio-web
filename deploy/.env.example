# Mẫu .env cho SERVER (thư mục ~/portfolio/, cạnh docker-compose.prod.yml và update.sh):
#   cp .env.example .env && chmod 600 .env   rồi điền giá trị thật. KHÔNG BAO GIỜ commit .env.
# Dùng bí mật MỚI cho production, không dùng lại giá trị của máy dev.
# Sinh khoá: python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# Bảo docker compose và update.sh dùng file prod (tên file giữ nguyên như khi scp lên).
COMPOSE_FILE=docker-compose.prod.yml

# Bắt buộc. Khoá nội bộ web <-> portfolio-api (cùng một giá trị cho cả hai service),
# >= 32 ký tự ASCII nhìn thấy được, không khoảng trắng. CHANGE_ME cố ý không hợp lệ.
PORTFOLIO_API_KEY=CHANGE_ME

# Bắt buộc. Mật khẩu trang quản trị /admin, 12..1024 ký tự.
ADMIN_PASSWORD=CHANGE_ME

# Tuỳ chọn (đang để giá trị mặc định):
# API_IMAGE_TAG=latest          (ghim bản api: sha-abc1234; hoặc chạy API_IMAGE_TAG=sha-abc1234 ./update.sh)
# WEB_IMAGE_TAG=latest          (ghim bản web, tương tự)
# KB_NETWORK=knowledge_base_default   (tên mạng của stack knowledge_base; xem `docker network ls`)
# CHAT_BACKEND_URL=http://chat:8003
# SESSION_TTL_DAYS=30
# ADMIN_SESSION_TTL_MINUTES=120
# SITE_URL=https://portfolio.sigpima.space   (chỉ để khớp lúc chạy; giá trị thật nằm trong ảnh, đổi tên miền phải build lại)
