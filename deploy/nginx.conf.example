# THAM KHẢO: nginx chạy ngoài Docker trên host. File này không chạy trong container nào.
# Sao chép vào cấu hình nginx của host (ví dụ /etc/nginx/sites-available/<ten-mien>),
# thay các giá trị TODO, rồi `nginx -t` và reload.
#
# 127.0.0.1:3100 là cổng service `portfolio` publish ra host (docker-compose.yml).

server {
    listen 80;
    server_name example.com www.example.com;   # TODO: tên miền thật
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;   # cần nginx >= 1.25.1; với bản cũ hơn bỏ dòng này và viết `listen 443 ssl http2;` ở trên
    server_name example.com www.example.com;   # TODO: tên miền thật

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # TODO: đường dẫn chứng chỉ TLS
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # TODO: đường dẫn khoá TLS

    # SSE của demo Knowledge Base: phải tắt buffer để các sự kiện chảy liền.
    # Đặt TRƯỚC `location /` không bắt buộc (nginx chọn theo độ dài tiền tố), nhưng để đây cho dễ đọc.
    location /api/chat/stream {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        client_max_body_size 64k;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # TODO (khuyến nghị): giới hạn tần suất cho /api/chat/stream bằng limit_req_zone/limit_req,
    # vì mỗi câu hỏi tốn một lượt gọi Gemini của bạn.
}
