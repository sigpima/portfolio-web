# THAM KHẢO: nginx chạy ngoài Docker trên host. File này không chạy trong container nào.
# Sao chép vào cấu hình nginx của host (ví dụ /etc/nginx/sites-available/<ten-mien>, file này
# được include bên trong khối `http { }`), thay các giá trị TODO, rồi `nginx -t` và reload.
#
# 127.0.0.1:3100 là cổng service `portfolio` publish ra host (docker-compose.yml).
# Chỉ web được đưa ra internet; portfolio-api (127.0.0.1:8100) và chat (127.0.0.1:8003)
# KHÔNG BAO GIỜ được proxy ra ngoài.
#
# Địa chỉ IP thật của người xem:
#   Ở production ứng dụng lấy khoá giới hạn tần suất CHỈ từ header `X-Real-IP` (không dùng
#   `X-Forwarded-For`: khi thiếu, Next tự điền địa chỉ kết nối, tức gateway của Docker). Vì vậy
#   MỌI location proxy bên dưới đặt `X-Real-IP` (và cả `X-Forwarded-For`) bằng $remote_addr
#   (địa chỉ kết nối thật tới nginx), thay vì $proxy_add_x_forwarded_for: biến đó nối thêm vào
#   chuỗi do client tự gửi, nên client có thể tự khai IP giả. Thiếu `X-Real-IP` thì mọi người
#   xem dùng chung MỘT khoá giới hạn `unknown` (log web in cảnh báo một lần).
#
#   Nếu chạy sau CDN/proxy khác (Cloudflare, ...): $remote_addr lúc đó là IP của CDN, mọi
#   người xem sẽ chung một khoá (và chung một bộ limit_req). Bật module real_ip trong khối
#   `server` (hoặc `http`) với ĐÚNG dải IP của CDN, ví dụ:
#     set_real_ip_from 173.245.48.0/20;     # TODO: danh sách dải IP chính thức của CDN
#     real_ip_header   CF-Connecting-IP;    # hoặc X-Forwarded-For + real_ip_recursive on;
#   Sau đó $remote_addr / $binary_remote_addr là IP người xem. Đừng bật real_ip với
#   set_real_ip_from 0.0.0.0/0: ai cũng tự khai được IP.

# Giới hạn tần suất theo IP (ngữ cảnh `http`). Mỗi câu hỏi chat tốn một lượt gọi Gemini của bạn.
# Lưu ý: $binary_remote_addr tính riêng từng địa chỉ IPv6 (/128), còn ứng dụng gộp IPv6 theo /64;
# một máy có cả dải /64 né được giới hạn của nginx, nhưng vẫn bị trần luồng đồng thời của portfolio-api chặn.
limit_req_zone $binary_remote_addr zone=chat_stream:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=invite_open:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;
# Trang dự án hỏi /api/chat/status mỗi lần tải; mỗi lần là một lời gọi tới portfolio-api và chat.
limit_req_zone $binary_remote_addr zone=chat_status:10m rate=30r/m;
# Twistfit: mỗi POST /api/twistfit/run bị từ chối (hết lượt, bận, thân sai) vẫn ghi một dòng `blocked` vào nhật ký,
# nên một link bị lạm dụng có thể làm ngập nhật ký; giới hạn riêng tuyến này (6 lượt/phút/IP, burst 4).
limit_req_zone $binary_remote_addr zone=twistfit_run:10m rate=6r/m;

server {
    listen 80;
    server_name example.com www.example.com;   # TODO: tên miền thật
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;   # cần nginx >= 1.25.1; với bản cũ hơn bỏ dòng này và viết `listen 443 ssl http2;` ở trên
    server_name example.com www.example.com;   # TODO: tên miền thật

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # TODO: đường dẫn chứng chỉ TLS
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # TODO: đường dẫn khoá TLS

    # Thân yêu cầu lớn nhất của site là vài KB (câu hỏi chat, đăng nhập, tạo link).
    client_max_body_size 64k;
    # Bị limit_req chặn thì trả 429 (mặc định nginx trả 503).
    limit_req_status 429;

    # Thân JSON cho 429 của các tuyến /api/ (trang web đọc được mã `rate_limited`;
    # trang lỗi HTML mặc định của nginx thì không). Dùng qua `error_page 429 = @rate_limited;`.
    location @rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 429 '{"code":"rate_limited"}';
    }

    # SSE của demo Knowledge Base: phải tắt buffer để các sự kiện chảy liền.
    location /api/chat/stream {
        limit_req zone=chat_stream burst=4 nodelay;
        error_page 429 = @rate_limited;

        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;

        proxy_set_header Host $host;
        # IP thật, không nối thêm vào chuỗi client gửi (xem đầu file).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Trạng thái demo chat: rẻ nhưng mỗi lần đi tới portfolio-api và chat, nên cũng giới hạn.
    location = /api/chat/status {
        limit_req zone=chat_status burst=20 nodelay;
        error_page 429 = @rate_limited;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Bắt đầu một lượt Twistfit (tốn tiền Flux). CHỈ tuyến này bị giới hạn: client hỏi trạng thái
    # /api/twistfit/jobs/ mỗi 1,5 giây, còn /catalog, /assets/ và /results/ được tải nhiều lần
    # mỗi lượt xem, nên chúng nằm trong `location /` và KHÔNG có limit_req.
    location = /api/twistfit/run {
        limit_req zone=twistfit_run burst=4 nodelay;
        error_page 429 = @rate_limited;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Link mời /i/<mã>: MÃ LINK NẰM TRÊN ĐƯỜNG DẪN. Access log của nginx ghi nguyên đường dẫn,
    # nên phải tắt log ở đây, nếu không mọi mã link (đủ để vào demo) nằm trong file log.
    # `access_log off` KHÔNG tắt error log: lần bị limit_req từ chối (mức `error`) và lỗi upstream
    # (`connect() failed`, `upstream prematurely closed`, 502 khi web đang khởi động lại) đều ghi
    # `request: "GET /i/<mã> HTTP/1.1"` vào error.log. Vì vậy error log của location này đổ vào
    # /dev/null (chỉ mức crit). Mọi nơi nhận error_log khác (syslog, file thêm ở `http`/`server`
    # kèm mức debug, ...) cũng KHÔNG được ghi đường dẫn này. Nhớ kiểm tra mọi proxy/CDN/công cụ
    # phân tích khác đứng trước nginx cũng không ghi đường dẫn này.
    location /i/ {
        access_log off;
        error_log /dev/null crit;
        limit_req zone=invite_open burst=10 nodelay;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Trang quản trị -------------------------------------------------------------------
    # BẮT BUỘC trước khi mở site: chỉ cho IP của bạn vào /admin và /api/admin/. Trong cả ba
    # location dưới, thay 192.0.2.1 (địa chỉ dành cho tài liệu, không ai có) bằng IP của bạn
    # (thêm dòng `allow` cho từng địa chỉ, kể cả IPv6 nếu mạng có IPv6). Để nguyên thì chính bạn
    # cũng bị 403: cố ý, để cấu hình chưa sửa thì đóng chứ không mở.
    # Đây là biện pháp CHÍNH chống lộ trang quản trị và chống bị khoá-chết đăng nhập: portfolio-api
    # giới hạn đăng nhập 5 lần/15 phút theo IP (đã băm) VÀ 60 lần/15 phút cho cả hệ thống, nên người
    # lạ dò mật khẩu từ nhiều IP có thể khiến chính bạn bị chặn (429) cho tới hết cửa sổ.
    # Chặn ở nginx thì người lạ không chạm tới được API.
    # Nếu bị khoá: trên máy chủ, trong thư mục portfolio-api, chạy
    #   docker compose up -d --force-recreate portfolio-api
    # (tạo lại container: xoá bộ giới hạn trong bộ nhớ và mọi phiên quản trị; link và nhật ký giữ
    # nguyên). `docker compose up -d` trơn KHÔNG làm gì khi cấu hình không đổi. Nếu .env không đổi,
    # `docker compose restart portfolio-api` cũng được.
    location /admin {
        allow 192.0.2.1;   # TODO: IP của bạn
        deny all;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/admin/login {
        allow 192.0.2.1;   # TODO: IP của bạn (giống /admin)
        deny all;
        limit_req zone=admin_login burst=5 nodelay;
        error_page 429 = @rate_limited;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/ {
        allow 192.0.2.1;   # TODO: IP của bạn (giống /admin)
        deny all;

        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # ---------------------------------------------------------------------------------------

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
