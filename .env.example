# Mẫu cho file .env cạnh docker-compose.yml: `cp .env.example .env && chmod 600 .env`, rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit .env (đã nằm trong .gitignore). docker compose tự đọc .env cho MỌI lệnh
# (up, logs, exec, cp, stop, down); thiếu PORTFOLIO_API_KEY thì lệnh nào cũng dừng với lỗi.
# Sinh khoá: python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# Bắt buộc. Khoá nội bộ web <-> portfolio-api: GIỐNG HỆT giá trị đặt cho portfolio-api,
# >= 32 ký tự ASCII nhìn thấy được, không khoảng trắng. CHANGE_ME cố ý không hợp lệ.
PORTFOLIO_API_KEY=CHANGE_ME

# Bắt buộc khi lên production: địa chỉ công khai của site. Dùng cả lúc build và lúc chạy
# (canonical, chuyển hướng của /i/<mã>, link hiện trên /admin). Đổi giá trị thì phải build lại.
SITE_URL=https://ten-mien-cua-ban

# Tuỳ chọn (đang để giá trị mặc định):
# PORTFOLIO_API_URL=http://portfolio-api:8100
# PORTFOLIO_API_NETWORK=portfolio-api_default   (chỉ đặt khi `docker network ls` cho tên khác; xem docs/RUNBOOK.md phần 3)
# PORTFOLIO_PORT=3100                           (cổng trên 127.0.0.1 của host)
# REQUIRE_SITE_URL=1                            (0 chỉ khi build thử trên máy)
